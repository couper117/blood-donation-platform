# Copy this file to `.env` and fill in the keys you have.
# The site runs fine without any of them - features that need a key
# simply say "not configured" until you add it.

# --- Server ---
PORT=3000

# Where the database and uploaded files are stored. Leave empty locally.
# ON RAILWAY: create a Volume, mount it (e.g. at /data), and set DATA_DIR=/data
# so your database and uploads survive every redeploy.
DATA_DIR=

# --- Real AI for the Quick Help chat + document checks ---
# RECOMMENDED (FREE): Google Gemini. Get a free key in minutes:
#   https://aistudio.google.com -> "Get API key". The free tier
#   (~1,500 requests/day) is plenty for this site.
GEMINI_API_KEY=
# Optional: pin a specific Gemini model (otherwise the server picks the
# best free Flash model automatically).
GEMINI_MODEL=

# Alternative (paid): Anthropic Claude - used only if GEMINI_API_KEY is
# empty. https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- REAL payments: Paypack (RECOMMENDED for Rwanda) ---
# Paypack charges customers via MTN Mobile Money & Airtel Money with an
# approval prompt on their phone - no card needed, no redirect.
# 1. Create an account at https://payments.paypack.rw (self-service).
# 2. Create an Application (give it cashin permission) - you get a
#    client id and client secret (the secret is shown ONCE - save it).
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
# "development" or "production" (which webhook environment your Paypack
# application uses). Keep "production" unless Paypack support says otherwise.
PAYPACK_MODE=production

# --- Alternative payments (Flutterwave - adds card support) ---
# Used only if the Paypack keys above are empty.
# Create a merchant account at https://flutterwave.com -> Settings -> API keys.
FLW_SECRET_KEY=

# Webhook secret: in the Flutterwave dashboard, go to Settings -> Webhooks,
# set the URL to <your public site>/api/payments/webhook and choose a secret
# hash - then put that same secret here. This makes sure a paid customer gets
# what they paid for even if they close the browser before returning.
FLW_WEBHOOK_HASH=

# Public URL of this site, used for the payment redirect back from Flutterwave.
# Keep as-is for local use; on Railway set it to your public URL
# (e.g. https://your-app.up.railway.app).
PUBLIC_URL=http://localhost:3000

# --- Urubuto Pay (BK TecHouse) - PREPARED, not yet active ---
# Urubuto Pay has NO public API documentation: merchants must contact
# BK TecHouse (https://urubutopay.rw) to be onboarded and receive the
# integration spec + credentials. Once you have them, fill these in and
# ask your developer/Claude to wire the adapter to their spec. Until
# then, Flutterwave above is the active (fully working) provider -
# nothing is ever faked for either provider.
URUBUTO_MERCHANT_CODE=
URUBUTO_API_KEY=
URUBUTO_API_SECRET=
URUBUTO_BASE_URL=

# --- Site administrator ---
# Log in from My Account -> Admin with this password to approve new
# hospitals/pharmacies and reset passwords. CHANGE THIS - the default
# (used when this is empty) is admin1234.
ADMIN_PASSWORD=
